    "bcrypt": "^5.1.1",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.10.10",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "vitest": "^3.0.4"
  }
}
